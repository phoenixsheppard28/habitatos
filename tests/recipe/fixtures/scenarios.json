      "recipe_id": "recipe-site",
      "version": "1",
      "query_ref": "q-site",
      "access_scope": "public",
      "inputs": {
        "habitat": {
          "dataset_id": "habitat",
          "version": "1"
        },
        "activities": {
          "dataset_id": "management",
          "version": "1"
        }
      },
      "steps": [
        {
          "id": "habitat_month",
          "operation": "time_bucket",
          "input": "habitat",
          "column": "observed_at",
          "output": "month",
          "period": "month"
        },
        {
          "id": "canopy",
          "operation": "aggregate",
          "input": "habitat_month",
          "group_by": [
            "site_id",
            "month"
          ],
          "aggregations": [
            {
              "column": "canopy",
              "method": "mean",
              "output": "mean_canopy"
            }
          ]
        },
        {
          "id": "activity_month",
          "operation": "time_bucket",
          "input": "activities",
          "column": "observed_at",
          "output": "month",
          "period": "month"
        },
        {
          "id": "costs",
          "operation": "aggregate",
          "input": "activity_month",
          "group_by": [
            "site_id",
            "month"
          ],
          "aggregations": [
            {
              "column": "cost",
              "method": "sum",
              "output": "total_cost"
            }
          ]
        },
        {
          "id": "combined",
          "operation": "join",
          "left": "canopy",
          "right": "costs",
          "keys": {
            "site_id": "site_id",
            "month": "month"
          },
          "type": "left",
          "cardinality": "one_to_one",
          "right_columns": {
            "total_cost": "total_cost"
          }
        }
      ],
      "output": {
        "step": "combined",
        "row_grain": "one site per UTC month",
        "keys": [
          "site_id",
          "month"
        ],
        "description": "Monthly sampled canopy aligned with recorded activity costs",
