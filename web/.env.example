# The Vite development proxy uses /geoserver by default.
# Set an absolute public URL when the services are hosted elsewhere.
VITE_GEOSERVER_URL=/geoserver
# The development frontend forwards /api to the Docker backend.
# Use http://127.0.0.1:8000 for the standalone Python server.
HABITAT_API_TARGET=http://127.0.0.1:8080
