# Optional for Docker: the stack uses its own PostGIS database.
# Required for a backend outside Docker, such as a Supabase session pooler (port 5432).
HABITAT_DATABASE_URL=

# Docker Compose settings. Select the database password before the first start.
HABITAT_PORT=8080
HABITAT_POSTGRES_PASSWORD=habitat-local

# Docker starts the local GLiClass service automatically.
HABITAT_CLASSIFIER_THRESHOLD=0.7
GLICLASS_THREADS=2
# Optional for a standalone backend with a separately hosted classifier.
HABITAT_CLASSIFIER_URL=

# Optional. Root of the raw archive and run reports. Default: <repo>/data
HABITAT_DATA_DIR=

# Claude: the fetch agent (--question) and catalog tags (--ai-tags).
ANTHROPIC_API_KEY=

# Optional. Full Movebank GPS CSV by study (free account at movebank.org).
MOVEBANK_USERNAME=
MOVEBANK_PASSWORD=

# Optional. Recipe PostGIS tests: a database where the tests may create and drop schemas.
# Supabase keeps PostGIS in the "extensions" schema.
RECIPE_TEST_DSN=
RECIPE_TEST_POSTGIS_SCHEMA=
