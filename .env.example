# Supabase session pooler connection string (port 5432).
HABITAT_DATABASE_URL=

# Optional. Root of the raw archive and run reports. Default: <repo>/data
HABITAT_DATA_DIR=

# Claude: the fetch agent (--question) and catalog tags (--ai-tags).
ANTHROPIC_API_KEY=

# Optional. Full Movebank GPS CSV by study (free account at movebank.org).
MOVEBANK_USERNAME=
MOVEBANK_PASSWORD=
